cc = clang
ld = ld.lld

cflags = -Iinclude -target x86_64-unknown-none -ffreestanding -fno-stack-protector -fno-pic -fno-pie -mno-red-zone -mno-sse -mno-sse2 -mcmodel=kernel -Wall -Wextra -O2
ucflags = -Iinclude/libc -Iinclude/userland -target x86_64-unknown-none -ffreestanding -fno-builtin -fno-stack-protector -fno-pic -fno-pie -mno-red-zone -mno-sse -mno-sse2 -mcmodel=small -Wall -Wextra -O2

rule cc
    command = $cc $cflags -c $in -o $out
    description = CC $in

rule ucc
    command = $cc $ucflags -c $in -o $out
    description = UCC $in

rule ld
    command = $ld -T linker.ld -o $out $in
    description = LD $out

rule uld
    command = $ld -T src/userland/user.ld -o $out $in
    description = ULD $out

rule nasm
    command = nasm -f elf64 -g -F dwarf $in -o $out
    description = NASM $in

# kernel

build build/object/entry.o: nasm src/kernel/entry.asm
build build/object/isr.o: nasm src/kernel/isr.asm
build build/object/user_entry.o: nasm src/kernel/user_entry.asm
build build/object/main.o: cc src/kernel/main.c
build build/object/renderer.o: cc src/kernel/renderer.c
build build/object/driver/keyboard.o: cc src/kernel/driver/keyboard.c
build build/object/gdt.o: cc src/kernel/gdt.c
build build/object/idt.o: cc src/kernel/idt.c
build build/object/syscall.o: cc src/kernel/syscall.c
build build/object/paging.o: cc src/kernel/paging.c
build build/object/pmm.o: cc src/kernel/pmm.c
build build/object/heap.o: cc src/kernel/heap.c
build build/object/elf.o: cc src/kernel/elf.c
build build/object/ata.o: cc src/kernel/ata.c
build build/object/fs/ext2.o: cc src/kernel/fs/ext2.c
build build/object/user.o: cc src/kernel/user/user.c
build build/object/shell.o: cc src/kernel/shell/shell.c

# libc

build build/object/libc/crt0.o: nasm src/libc/crt0.asm
build build/object/libc/syscall.o: ucc src/libc/syscall.c
build build/object/libc/errno.o: ucc src/libc/errno.c
build build/object/libc/unistd.o: ucc src/libc/unistd.c
build build/object/libc/string.o: ucc src/libc/string.c
build build/object/libc/stdlib.o: ucc src/libc/stdlib.c
build build/object/libc/stdio.o: ucc src/libc/stdio.c

# userland elf

build build/object/userland/init.o: ucc src/userland/init.c
build build/object/userland/hello.o: ucc src/userland/hello.c
build build/object/userland/shell.o: ucc src/userland/shell.c

build build/userland/init.elf: uld $
    build/object/libc/crt0.o $
    build/object/libc/syscall.o $
    build/object/libc/errno.o $
    build/object/libc/unistd.o $
    build/object/libc/string.o $
    build/object/libc/stdlib.o $
    build/object/libc/stdio.o $
    build/object/userland/init.o

build build/userland/shell.elf: uld $
    build/object/libc/crt0.o $
    build/object/libc/syscall.o $
    build/object/libc/errno.o $
    build/object/libc/unistd.o $
    build/object/libc/string.o $
    build/object/libc/stdlib.o $
    build/object/libc/stdio.o $
    build/object/userland/shell.o

build build/userland/hello.elf: uld $
    build/object/libc/crt0.o $
    build/object/libc/syscall.o $
    build/object/libc/errno.o $
    build/object/libc/unistd.o $
    build/object/libc/string.o $
    build/object/libc/stdlib.o $
    build/object/libc/stdio.o $
    build/object/userland/hello.o

build build/object/init/elf.o: nasm src/kernel/init_elf.asm || build/userland/init.elf

build build/uorix.elf: ld $
    build/object/entry.o $
    build/object/isr.o $
    build/object/user_entry.o $
    build/object/main.o $
    build/object/renderer.o $
    build/object/driver/keyboard.o $
    build/object/gdt.o $
    build/object/idt.o $
    build/object/syscall.o $
    build/object/paging.o $
    build/object/pmm.o $
    build/object/heap.o $
    build/object/elf.o $
    build/object/ata.o $
    build/object/fs/ext2.o $
    build/object/init/elf.o $
    build/object/user.o $
    build/object/shell.o

default build/uorix.elf $
    build/userland/shell.elf $
    build/userland/hello.elf
